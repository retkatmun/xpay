# XPay Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
#
# To generate SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or:
#   openssl rand -base64 32

NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Start the local dev database: docker compose up -d postgres  (see docker-compose.yml)
DATABASE_URL="postgres://xpay:xpay@localhost:5433/xpay"

# ── Security ───────────────────────────────────────────────────────────────────
# Used for cookie signing and token hashing.
# MINIMUM 32 random characters. NEVER commit. NEVER share.
SESSION_SECRET=""

# Allowed frontend origin for CORS. In production, set to your actual domain.
CORS_ORIGIN="http://localhost:3000"

# ── PIN policy ─────────────────────────────────────────────────────────────────
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ── OTP / session TTLs ─────────────────────────────────────────────────────────
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=30

# ── Quote engine ───────────────────────────────────────────────────────────────
# How long a quote is valid (seconds). User must confirm within this window.
QUOTE_TTL_SECONDS=300

# Platform fee in NGN (whole naira). 0 = no fee.
FEE_NGN=0

# ── Paystack ───────────────────────────────────────────────────────────────────
# GET IT FROM: https://dashboard.paystack.com/#/settings/developer
# Test key (sk_test_...):   for development — uses Paystack test environment
# Live key (sk_live_...):   for production — uses Paystack live environment
#
# REQUIRED for:
#   - GET  /api/banks               (live Nigerian bank list)
#   - POST /api/banks/resolve       (real account name lookup)
#   - POST /api/transactions        (NGN payout to bank account)
#   - POST /api/webhooks/paystack   (webhook signature verification)
#
# NEVER put this in frontend code. NEVER log it. NEVER commit it.
PAYSTACK_SECRET_KEY=""

PAYSTACK_BASE_URL="https://api.paystack.co"

# How long to cache the bank list from Paystack (seconds). Default 6 hours.
PAYSTACK_BANK_CACHE_TTL=21600

# ── Base Sepolia / Blockchain ──────────────────────────────────────────────────
# Base Sepolia chain ID — do not change.
BASE_CHAIN_ID=84532

# RPC URL for Base Sepolia.
# Free options:
#   Public endpoint (no key): https://sepolia.base.org
#   Alchemy (free tier):       https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
#   QuickNode (free tier):     https://YOUR_ENDPOINT.base-sepolia.quiknode.pro/YOUR_KEY/
BASE_RPC_URL="https://sepolia.base.org"

# Base Sepolia block explorer base URL.
BASE_EXPLORER_URL="https://sepolia.basescan.org"

# Official USDC contract on Base Sepolia — do not change.
# Source: https://developers.circle.com/stablecoins/usdc-on-test-networks
USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Treasury wallet private key for signing USDC transfers.
# This is an EVM private key (0x-prefixed, 64 hex chars).
#
# GET IT FROM (create a new wallet — do NOT reuse a personal wallet):
#   cast wallet new              (if you have Foundry installed)
#   node -e "const {privateKeyToAccount} = require('viem/accounts');
#     const k = '0x'+require('crypto').randomBytes(32).toString('hex');
#     console.log('PRIVATE KEY:', k);
#     console.log('ADDRESS:', privateKeyToAccount(k).address)"
#
# Fund it with:
#   Base Sepolia ETH:  https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
#   Base Sepolia USDC: https://faucet.circle.com
#
# NEVER commit this. NEVER log this. NEVER send it to the frontend.
# In production, use a KMS / secrets manager — NOT a .env file.
BASE_PRIVATE_KEY=""

# Required blockchain confirmations before initiating payout.
REQUIRED_CONFIRMATIONS=2

# How long to poll for blockchain confirmation (ms). Default 2 minutes.
CONFIRM_BUDGET_MS=120000

# ── FX Provider ───────────────────────────────────────────────────────────────
# Which FX rate provider to use for USD/NGN quotes.
# Options: "exchangerate-api" | "openexchangerates" | "fixer"
#
# exchangerate-api free open endpoint — no API key needed (limited to ~1,500 req/month with key).
# FX_API_KEY can be left empty for the open endpoint.
FX_PROVIDER="exchangerate-api"

# API key (optional for exchangerate-api free open endpoint).
# Required for openexchangerates and fixer.
# GET IT FROM: your chosen FX provider's dashboard
FX_API_KEY=""

# Override the FX API base URL (optional — uses provider default if empty).
# FX_API_URL=""

# ── SMS / Termii ──────────────────────────────────────────────────────────────
# Real SMS delivery via Termii — https://termii.com
#
# GET YOUR API KEY:
#   1. Sign up at https://accounts.termii.com/#/
#   2. Go to Settings → API Key
#   3. Copy the key into TERMII_API_KEY
#
# REQUIRED — OTPs are delivered as real SMS when this is set.
TERMII_API_KEY=

# ── DEV OTP display ───────────────────────────────────────────────────────────
# DEV_SHOW_OTP=true allows OTP codes to appear in the API response.
# This ONLY works in NODE_ENV=development. It is BLOCKED in production.
# Use only for local development when you don't have a Termii key yet.
# The correct production setup is TERMII_API_KEY + DEV_SHOW_OTP=false.
DEV_SHOW_OTP=false
