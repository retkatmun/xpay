# XPay Frontend Environment Variables

# Backend API URL
VITE_API_URL=http://localhost:4000

# Privy Authentication
VITE_PRIVY_APP_ID=your-privy-app-id

# Supabase (get these from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 0x Swap API
VITE_0X_API_KEY=your-0x-api-key

# Blockscout API key (optional — raises rate limit from 5 RPS to 15 RPS on the free tier)
# Get a free key at https://dev.blockscout.com
VITE_BLOCKSCOUT_API_KEY=
